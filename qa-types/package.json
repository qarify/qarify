{
  "name": "@qarify/types",
  "version": "1.0.0",
  "description": "QArify types and interfaces",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "qarify",
    "test"
  ],
  "author": "PHSK <peterhs.kang@gmail.com>",
  "license": "MIT",
  "type": "module",
  "types": "./types.d.ts",
  "main": "./dist/__cjs/index.js",
  "exports": {
    ".": [
      {
        "types": "./types.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/__cjs/index.js"
      },
      "./dist/__cjs/index.js"
    ]
  },
  "scripts": {
    "test:types": "tsc --skipLibCheck",
    "compile": "run-s compile:*",
    "compile:esm": "tsc -b ./tsconfig.build.json",
    "compile:cjs": "tsc -b ./tsconfig.cjs.json",
    "clean:build": "rimraf dist",
    "build": "run-s clean:build compile:*",
    "postinstall": "npm run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.1",
    "typescript": "~5.1.6",
    "@wdio/types": "8.10.4",
    "webdriver": "8.11.1"
  },
  "optionalDependencies": {
    "@wdio/types": "8.10.4",
    "webdriver": "8.11.1"
  }
}
