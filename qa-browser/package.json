{
  "name": "@qarify/browser",
  "version": "0.9.0",
  "description": "QArify for Browser",
  "author": "Peter HS Kang <peterhs.kang@gmail.com>",
  "type": "module",
  "main": "./dist/qarify-browser.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": [{
        "types": "./dist/index.d.ts",
        "import": "./dist/qarify-browser.js",
        "require": "./dist/qarify-browser.umd.cjs"
      },
      "./dist/qarify-browser.umd.cjs"
    ]
  },
  "scripts": {
    "test:watch": "vitest ./test/unit/*.spec.ts",
    "test": "vitest run ./test/unit/*.spec.ts",
    "e2e": "vitest run ./test/e2e/*.spec.ts",
    "build": "vite build",
    "bundle": "vite build",
    "bundle:watch": "vite build --watch",
    "compile": "run-s bundle",
    "clean:build": "rimraf dist"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "jsdom": "~24.0.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5",
    "vite": "~5.0.12",
    "vite-tsconfig-paths": "~4.3.1"
  },
  "license": "MIT",
  "keywords": [
    "QA",
    "test"
  ]
}
