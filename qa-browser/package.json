{
  "name": "@qarify/browser",
  "version": "0.9.0",
  "description": "QArify for Browser",
  "author": "Peter HS Kang <peterhs.kang@gmail.com>",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./logger": {
      "types": "./dist/qa-logger/src/index.d.ts",
      "import": "./dist/qa-logger.js"
    },
    "./drivers": {
      "types": "./dist/qa-drivers/src/index.d.ts",
      "import": "./dist/qa-drivers.js"
    },
    "./pages": {
      "types": "./dist/qa-pages/src/index.d.ts",
      "import": "./dist/qa-pages.js"
    }
  },
  "scripts": {
    "build": "run-s bundle type",
    "bundle": "vite build",
    "compile": "run-s bundle type",
    "type": "npx tsc --noEmit false --declarationDir dist --declaration --emitDeclarationOnly",
    "clean:build": "rimraf dist"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "memfs": "~4.4.0",
    "node-stdlib-browser": "~1.2.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5",
    "vite": "~5.0.12",
    "vite-tsconfig-paths": "~4.3.1"
  },
  "license": "MIT",
  "keywords": [
    "QA",
    "test"
  ]
}
