{
  "name": "@qarify/browser",
  "version": "0.9.0",
  "description": "QArify for Browser",
  "author": "Peter HS Kang <peterhs.kang@gmail.com>",
  "type": "module",
  "main": "./dist/qarify-browser.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": [{
        "types": "./dist/index.d.ts",
        "import": "./dist/qarify-browser.js",
        "require": "./dist/qarify-browser.umd.cjs"
      },
      "./dist/qarify-browser.umd.cjs"
    ]
  },
  "scripts": {
    "test:watch": "vitest --dir ./src",
    "test": "vitest run --dir ./src",
    "test:browser": "vitest run --dir ./test/e2e --mode browser_test",
    "build": "vite build --force",
    "build:watch": "vite build --watch",
    "compile": "run-s build",
    "clean:build": "rimraf dist"
  },
  "dependencies": {
    "@qarify/browser": "file:.",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "debug": "^4.3.4",
    "webdriver": "8.29.7",
    "webdriverio": "8.29.7"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.11.16",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "~1.2.2",
    "@vitest/ui": "~1.2.2",
    "jsdom": "~24.0.0",
    "memfs": "^4.7.0",
    "msw": "^2.1.6",
    "playwright": "^1.41.2",
    "node-stdlib-browser": "^1.2.0",
    "vite-plugin-ti-browserify": "*",
    "rollup-plugin-typescript2": "^0.36.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.5",
    "vite": "~5.0.12",
    "vitest": "~1.2.2",
    "vite-tsconfig-paths": "~4.3.1"
  },
  "license": "MIT",
  "keywords": [
    "QA",
    "test"
  ]
}
