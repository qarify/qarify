{
  "name": "@qarify/pages",
  "version": "0.9.1",
  "description": "QArify Pages",
  "author": "Peter HS Kang <peterhs.kang@gmail.com>",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/__cjs/index.js",
  "exports": {
    ".": [
      {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/__cjs/index.js"
      },
      "./dist/__cjs/index.js"
    ]
  },
  "scripts": {
    "test:file": "mocha src/parse-page-src.spec.ts",
    "test": "mocha src/**/*.spec.ts",
    "test:types": "tsc --skipLibCheck",
    "compile": "tsc -b ./tsconfig.build.json ./tsconfig.cjs.json",
    "compile:esm": "tsc -b ./tsconfig.build.json",
    "compile:cjs": "tsc -b ./tsconfig.cjs.json",
    "compile:browser": "vite build --emptyOutDir --force",
    "clean:build": "rimraf dist",
    "build": "run-s clean:build compile"
  },
  "dependencies": {
    "@qarify/drivers": "^0.9.1",
    "@qarify/globals": "^0.9.1",
    "@qarify/logger": "^0.9.1",
    "@qarify/types": "^0.9.1",
    "@wdio/protocols": "8.24.12",
    "@xmldom/xmldom": "~0.8.10",
    "lru-cache": "~10.0.2",
    "xpath": "^0.0.33"
  },
  "license": "MIT",
  "keywords": [
    "QA",
    "test"
  ]
}
