{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    /* Emit */
    "outDir": "dist/__cjs",
    "declaration": false,

    /* Modules */
    "module": "CommonJS",
  },
  "include": [
    "./src",
  ],
  "exclude": [
    "./dist",
    "./tests",
    "./src/**/*-esm.ts",
    "./src/**/*.spec.ts",
    "./src/**/__mock",
    "./src/**/*.browser.ts",
  ]
}
