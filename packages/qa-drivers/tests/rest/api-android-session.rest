# appium api
# - https://appium.github.io/appium/docs/en/2.0/reference/commands/appium_base_driver-1._appium_base_driver/

@BASE_URL=http://localhost:4723

#
# get current server status
#
GET {{BASE_URL}}/status
###

#
# create android session without default app
#
# @name android_session
POST {{BASE_URL}}/session HTTP/1.1
content-type: application/json

{
  "capabilities": {
    "alwaysMatch": {
      "platformName": "android",
      "appium:automationName": "UiAutomator2",
      "appium:avd": "Pixel_API_33",
      "appium:platformVersion": "13.0",
      "appium:orientation": "PORTRAIT"
    }
  }
}
###

#@android_session_id = {{android_session.response.body.value.sessionId}}

#
# get all sessions
# @name get_sessions
GET {{BASE_URL}}/sessions
###
@android_session_id = {{get_sessions.response.body.value[0].id}}


#
# get session info
#
GET {{BASE_URL}}/session/{{android_session_id}}
###

#
# launch app with deep link
#
POST {{BASE_URL}}/session/{{android_session_id}}/execute/sync

{
  "script":"mobile:deepLink",
  "args":[{
    "url":"exp://127.0.0.1:19000/--/main/home",
    "package":"host.exp.exponent"
  }]
}
###

#
# launch app with bundle id
#
POST {{BASE_URL}}/session/{{android_session_id}}/execute/sync

{
  "script":"mobile:startActivity",
  "args":[{
    "intent":"com.android.settings/.Settings"
  }]
}
