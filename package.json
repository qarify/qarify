{
  "name": "qarify-js-root",
  "type": "module",
  "private": true,
  "scripts": {
    "@browser": "npm run -w @qarify/browser ",
    "test:types": "npm run -ws test:types",
    "test": "npm test -ws",
    "e2e": "npm run -ws e2e --if-present",
    "=== Build & Clean ===": "",
    "compile": "bash ./scripts/setup.sh b",
    "build": "bash ./scripts/setup.sh B",
    "clean-build": "bash scripts/setup.sh DUibl",
    "setup": "bash scripts/setup.sh ibl",
    "clean": "npm run -ws clean:build",
    "clean:all": "bash ./scripts/setup.sh CU",
    "=== Utility ===": "",
    "get-src": "node scripts/get-src/get-src.js"
  },
  "resolutions": {
    "webdriver": "8.29.7",
    "webdriverio": "8.29.7",
    "expect-webdriverio": "4.9.4"
  },
  "devDependencies": {
    "@types/mocha": "~10.0.1",
    "@types/node": "^20.4.8",
    "canvas": "^2.11.2",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.0",
    "webdriver": "8.29.7",
    "webdriverio": "8.29.7",
    "expect-webdriverio": "4.9.4",
    "mocha": "~10.2.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3",
    "vite": "~5.0.12",
    "vite-tsconfig-paths": "~4.3.1",
    "vitest": "~1.2.2"
  },
  "workspaces": [
    "packages/*"
	]
}
