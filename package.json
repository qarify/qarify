{
  "name": "qarify-js-root",
  "type": "module",
  "private": true,
  "scripts": {
    "test:types": "npm run -ws test:types",
    "test": "npm test -ws",
    "e2e": "npm run -ws e2e --if-present",
    "compile:browser": "npm run -ws compile:browser",
    "get-src": "node scripts/get-src/get-src.js",
    "build": "bash ./scripts/setup.sh B",
    "compile": "bash ./scripts/setup.sh b",
    "setup": "bash scripts/setup.sh ibl",
    "clean-setup": "bash scripts/setup.sh DUibl",
    "clean": "npm run -ws clean:build",
    "clean:all": "bash ./scripts/setup.sh CU"
  },
  "devDependencies": {
    "@types/mocha": "~10.0.1",
    "@types/node": "^20.4.8",
    "canvas": "^2.11.2",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.0",
    "expect-webdriverio": "4.9.3",
    "mocha": "~10.2.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3",
    "vite": "~5.0.12",
    "vite-tsconfig-paths": "~4.3.1"
  },
  "workspaces": [
    "qa-*"
	]
}
