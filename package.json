{
  "name": "qarify-js-root",
  "type": "module",
  "private": true,
  "scripts": {
    "test:types": "npm run -ws test:types",
    "test": "npm test -ws",
    "build": "npm run -ws build",
    "e2e": "npm run -ws e2e --if-present",
    "compile": "npm run -ws compile",
    "compile:browser": "npm run -ws compile:browser",
    "clean": "npm run -ws clean:build",
    "get-src": "node scripts/get-src/get-src.js",
    "setup": "bash scripts/setup.sh il",
    "setup:full": "npm run setup ibl",
    "patch:gen": "node ./scripts/patch-gen.js @wdio/logger ./patches/browser-env",
    "patch:node": "node ./scripts/patch-apply.js ./patches/node-env",
    "patch:vsce": "sh scripts/patch-apply-vsce.sh ; npm run link:deps && npm run build"
  },
  "devDependencies": {
    "@types/mocha": "~10.0.1",
    "@types/node": "^20.4.8",
    "canvas": "^2.11.2",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.0",
    "expect-webdriverio": "4.9.3",
    "mocha": "~10.2.0",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3",
    "vite": "~5.0.12",
    "vite-tsconfig-paths": "~4.3.1"
  },
  "workspaces": [
    "qa-*"
	]
}
