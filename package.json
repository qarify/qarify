{
  "name": "qarify-mono-repo",
  "private": true,
  "scripts": {
    "compile": "lerna run compile",
    "build": "lerna run build",
    "clean": "lerna run clean:build",
    "test:types": "lerna run test:types",
    "test": "lerna run test",
    "e2e": "lerna run e2e",
    "setup": "bash scripts/setup.sh",
    "setup:full": "bash scripts/setup.sh cibl",
    "link:deps": "npm link @wdio/types webdriverio expect-webdriverio",
    "patch:gen": "node ./scripts/patch-gen.js @wdio/logger ./patches/browser-env",
    "patch:node": "node ./scripts/patch-apply.js ./patches/node-env",
    "patch:vsce": "sh scripts/patch-apply-vsce.sh ; npm run link:deps && npm run build"
  },
  "devDependencies": {
    "lerna": "~7.1.1",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.0",
    "rimraf": "^5.0.1"
  },
  "workspaces": [
		"qarify",
    "qa-*"
	]
}
