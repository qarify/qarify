{
  "name": "qarify-mono-repo",
  "private": true,
  "scripts": {
    "test:types": "lerna run test:types",
    "test": "lerna run test",
    "build": "lerna run build",
    "e2e": "lerna run --concurrency 1 e2e",
    "compile": "lerna run compile",
    "compile:browser": "lerna run compile:browser",
    "clean": "lerna run clean:build",
    "setup": "npm run link:deps && bash scripts/setup.sh",
    "setup:full": "npm run setup ibl",
    "link:deps": "npm link @wdio/config @wdio/logger @wdio/protocols @wdio/types @wdio/utils webdriver webdriverio expect-webdriverio",
    "patch:gen": "node ./scripts/patch-gen.js @wdio/logger ./patches/browser-env",
    "patch:node": "node ./scripts/patch-apply.js ./patches/node-env",
    "patch:vsce": "sh scripts/patch-apply-vsce.sh ; npm run link:deps && npm run build"
  },
  "devDependencies": {
    "lerna": "~7.1.1",
    "npm-run-all": "^4.1.5",
    "patch-package": "^8.0.0",
    "rimraf": "^5.0.1",
    "vite": "~4.4.9",
    "vite-tsconfig-paths": "~4.2.1",
    "node-stdlib-browser": "~1.2.0",
    "@rollup/plugin-inject": "~5.0.3",
    "memfs": "~4.5.0",
    "buffer": "~6.0.3",
    "process": "~0.11.10"
  },
  "workspaces": [
    "qa-*"
	]
}
