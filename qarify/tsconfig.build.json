{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Emit */
    "outDir": "./dist",
    "noEmit": false,
    "sourceMap": false,
    "declaration": true,
    "removeComments": true,
  },
  "include": [
    "./src",
  ],
  "exclude": [
    "./dist",
    "./tests",
    "./src/**/*.cts",
    "./src/**/*.spec.ts",
    "./src/**/__mock",
  ]
}
