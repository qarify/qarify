{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Emit */
    "noEmit": false,
    "outDir": "dist",
    "declaration": true,

    /* Language and Environment */
    "target": "ES2020",

    /* Modules */
    "module": "ES2020",
    "rootDir": "./src",
  },
  "include": [
    "./src",
  ],
  "exclude": [
    "./src/**/*.cts",
    "./src/**/*.spec.ts",
  ]
}
