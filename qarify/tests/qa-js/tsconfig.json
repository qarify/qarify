{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ESNext",
    /* Modules */
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "types": [
      "mocha", "@qarify/globals"
    ],
    "noEmit": true
  },
  "include": [
    "./specs",
    "./tasks",
  ],
}
