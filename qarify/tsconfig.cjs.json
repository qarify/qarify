{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    /* Emit */
    "outDir": "dist/__cjs",

    /* Language and Environment */
    "target": "ES2020",

    /* Modules */
    "module": "CommonJS",
  },
  "include": [
    "./src",
  ],
  "exclude": [
    "./src/**/*.mts",
    "./src/**/*.spec.ts",
  ]
}
