{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Emit */
    "noEmit": false,
    "outDir": "dist/__cjs",

    /* Language and Environment */
    "target": "ES2020",

    /* Modules */
    "module": "CommonJS",
    "rootDir": "./src",
  },
  "include": [
    "./src/*.ts",
  ],
  "exclude": [
    "./src/*.mts",
  ]
}
