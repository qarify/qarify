{
  "name": "qarify",
  "version": "1.0.0",
  "private": false,
  "author": "Peter HS Kang <peterhs.kang@gmail.com>",
  "description": "QArify",
  "license": "MIT",
  "keywords": [
    "QA",
    "test"
  ],
  "bin": {
    "qarify": "./bin/qarify.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/__cjs/index.js"
  },
  "scripts": {
    "dev": "./bin/qarify.js",
    "dev2": "./bin/qarify.js -c ./.qarify-remote.json",
    "build": "run-s clean:compile compile",
    "compile": "run-p compile:*",
    "compile:esm": "tsc -b tsconfig.build.json",
    "compile:cjs": "tsc -b tsconfig.cjs.json",
    "clean:compile": "rimraf ./dist",
    "patch:gen": "node ./scripts/patch-gen.js @wdio/logger ./patches/browser-env",
    "patch:apply": "node ./scripts/patch-apply.js ./patches/node-env"
  },
  "dependencies": {
    "@qarify/globals": "1.0.0",
    "commander": "^11.0.0",
    "execa": "^7.2.0",
    "mocha": "^10.2.0",
    "webdriverio": "8.11.3",
    "expect-webdriverio": "4.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.4.8",
    "@types/mocha": "^10.0.0",
    "typescript": "~5.1.6",
    "patch-package": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.1"
  }
}
