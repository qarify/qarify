{
  "name": "qarify",
  "version": "0.9.0",
  "description": "QArify Core",
  "private": false,
  "author": "Peter HS Kang <peterhs.kang@gmail.com>",
  "license": "MIT",
  "keywords": [
    "QA",
    "test"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/__cjs/index.js",
  "exports": {
    ".": [
      {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/__cjs/index.js"
      },
      "./dist/__cjs/index.js"
    ]
  },
  "scripts": {
    "test": "mocha",
    "test:types": "tsc --skipLibCheck",
    "compile": "tsc -b ./tsconfig.build.json ./tsconfig.cjs.json",
    "compile:esm": "tsc -b ./tsconfig.build.json",
    "compile:cjs": "tsc -b ./tsconfig.cjs.json",
    "clean:build": "rimraf dist",
    "build": "run-s clean:build compile",
    "patch:gen": "node ./scripts/patch-gen.js @wdio/logger ./patches/browser-env",
    "patch:apply": "node ./scripts/patch-apply.js ./patches/node-env",
    "patch:vsce": "sh scripts/patch-vsce.sh"
  },
  "dependencies": {
    "@qarify/globals": "0.9.0",
    "@qarify/types": "0.9.0",
    "debug": "^4.3.4",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "webdriverio": "8.10.7",
    "expect-webdriverio": "4.2.6"
  },
  "devDependencies": {
    "@types/debug": "^4.1.8",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.4.8",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.1",
    "ts-node": "^10.9.1",
    "typescript": "~5.1.6"
  }
}
