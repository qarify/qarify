{
  "name": "qarify",
  "version": "1.0.0",
  "private": false,
  "author": "Peter HS Kang <peterhs.kang@gmail.com>",
  "description": "QArify",
  "license": "MIT",
  "keywords": [
    "QA",
    "test"
  ],
  "bin": {
    "qarify": "./bin/qarify.js"
  },
  "type": "module",
  "main": "./dist/__cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "node --loader=ts-node/esm ./bin/qarify.js",
    "e2e:default": "DEBUG='qarify:*' node ./bin/qarify.js",
    "e2e:remote": "node ./bin/qarify.js -c tests/qarify-remote.json",
    "e2e:js": "DEBUG='qarify:*' node ./bin/qarify.js -c tests/qarify-js.json",
    "e2e:js-build": "DEBUG='qarify:*' node ./bin/qarify.js -c tests/qarify-js.json --forceBuild",
    "e2e:esm": "DEBUG='qarify:*' node ./bin/qarify.js -c tests/qarify-esm.json",
    "e2e:build": "DEBUG='qarify:*' node ./bin/qarify.js -c tests/qarify-build.json",
    "test": "mocha",
    "test:types": "tsc --noEmit",
    "build": "run-s clean:compile compile",
    "compile": "run-p compile:*",
    "compile:esm": "tsc -b tsconfig.build.json",
    "compile:cjs": "tsc -b tsconfig.cjs.json",
    "clean:compile": "rimraf ./dist",
    "patch:gen": "node ./scripts/patch-gen.js @wdio/logger ./patches/browser-env",
    "patch:apply": "node ./scripts/patch-apply.js ./patches/node-env"
  },
  "dependencies": {
    "@qarify/globals": "1.0.0",
    "commander": "^11.0.0",
    "execa": "^7.2.0",
    "mocha": "^10.2.0",
    "glob": "^10.3.3",
    "webdriverio": "^8.15.4",
    "expect-webdriverio": "^4.2.7"
  },
  "devDependencies": {
    "@types/debug": "^4.1.8",
    "@types/node": "^20.4.8",
    "@types/mocha": "^10.0.0",
    "debug": "^4.3.4",
    "ts-node": "^10.9.1",
    "typescript": "~5.1.6",
    "patch-package": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.1"
  }
}
